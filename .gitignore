# WordPress core files – should not be versioned
wp-admin/
wp-includes/

# WordPress content to ignore (but keep your custom theme!)
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/

# Αγνόησε όλα τα plugins
wp-content/plugins/*
!wp-content/plugins/shopify-product-importer
!wp-content/plugins/shopify-products-api
!wp-content/plugins/supplier-shipping-rules
!wp-content/plugins/petling-user-pets
!wp-content/plugins/petling-admin-table-views-customizer
!wp-content/plugins/petling-crm
!wp-content/plugins/petling-partners-promo
!wp-content/plugins/yoggies-importer
!petling-nutrition-advisor

# Εξαιρέσεις - συμπερίλαβε τον custom φάκελο και τα περιεχόμενά του
!wp-content/plugins/elementor-pro/
!wp-content/plugins/elementor-pro/**


# System files
.DS_Store
Thumbs.db

# IDE/editor config files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Log files
*.log

# Build artifacts (if using any build tools)
node_modules/
dist/
build/
*.zip
*.tar.gz

# Composer dependencies and lock file
/vendor/
composer.lock

# Environment files, backups, temporary/swap files
.env
.env.*
*.bak
*.tmp
*.swp

# Για το custom plugin τα access token, γιατί εντός του κώδικα δε μου επέτρεπε το git 
# να τα pusharw
.env